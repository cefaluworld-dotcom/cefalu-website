// Cefalu — Platform database (PostgreSQL)
// Medusa owns commerce (products, carts, orders, payments, inventory);
// entities marked "mirror" reference Medusa IDs for reporting/audit and are
// filled by webhook/sync jobs. Everything else is mastered here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

/* ----------------------------- Identity ------------------------------ */

enum RoleName {
  ADMIN
  MODERATOR
  CUSTOMER
}

model User {
  id               String    @id @default(cuid())
  medusaCustomerId String?   @unique
  email            String    @unique
  name             String?
  phone            String?
  passwordHash     String?   // null for OAuth-only accounts
  emailVerifiedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  roles         UserRole[]
  addresses     Address[]
  reviews       Review[]
  wishlist      WishlistItem[]
  notifications Notification[]
  tickets       SupportTicket[]
  subscriptions Subscription[]
  activityLogs  ActivityLog[]

  @@index([deletedAt])
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique // e.g. "orders:refund", "reviews:moderate"
  label String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String   @default("Home")
  firstName  String
  lastName   String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String   @db.VarChar(6)
  phone      String   @db.VarChar(10)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/* ------------------------- Catalog & content ------------------------- */

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  logoUrl  String?
  products Product[]
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Collection {
  id       String              @id @default(cuid())
  name     String
  slug     String              @unique
  products ProductCollection[]
}

/// Mirror of Medusa product + Cefalu enrichment mastered here.
model Product {
  id               String   @id @default(cuid())
  medusaProductId  String?  @unique
  slug             String   @unique
  name             String
  shortDescription String
  longDescription  String
  brandId          String?
  categoryId       String?
  subcategory      String?
  benefits         String[]
  features         String[]
  directions       String
  warnings         String[]
  storage          String
  tags             String[]
  images           String[]
  videos           String[]
  mrp              Int // paise-free INR
  offerPrice       Int
  subscriptionPct  Int      @default(15)
  sku              String?  @unique
  rating           Decimal  @default(0) @db.Decimal(2, 1)
  reviewCount      Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  brand           Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category        Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collections     ProductCollection[]
  ingredients     ProductIngredient[]
  nutritionRows   NutritionRow[]
  faqs            Faq[]
  clinicalStudies ClinicalStudy[]
  reviews         Review[]
  wishlistItems   WishlistItem[]

  @@index([categoryId, isActive])
  @@index([brandId])
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Ingredient {
  id       String              @id @default(cuid())
  name     String              @unique
  slug     String              @unique
  form     String
  category String
  benefits String[]
  research String
  source   String
  products ProductIngredient[]
}

model ProductIngredient {
  productId    String
  ingredientId String
  amount       String
  purpose      String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
}

model NutritionRow {
  id         String  @id @default(cuid())
  productId  String
  nutrient   String
  perServing String
  rda        String
  sortOrder  Int     @default(0)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ClinicalStudy {
  id        String          @id @default(cuid())
  productId String?
  title     String
  journal   String
  year      Int
  finding   String
  doi       String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  papers    ResearchPaper[]

  @@index([productId])
}

model ResearchPaper {
  id       String         @id @default(cuid())
  studyId  String?
  title    String
  url      String
  authors  String?
  abstract String?
  study    ClinicalStudy? @relation(fields: [studyId], references: [id], onDelete: SetNull)
}

model Faq {
  id        String   @id @default(cuid())
  productId String?
  category  String   @default("general")
  question  String
  answer    String
  sortOrder Int      @default(0)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([category, sortOrder])
}

model Blog {
  id          String    @id @default(cuid())
  sanityId    String?   @unique // mastered in Sanity; mirrored for joins/search
  slug        String    @unique
  title       String
  excerpt     String?
  authorName  String?
  publishedAt DateTime?
  tags        String[]

  @@index([publishedAt])
}

model Doctor {
  id          String  @id @default(cuid())
  name        String
  credentials String
  role        String
  quote       String
  imageUrl    String?
  sortOrder   Int     @default(0)
}

/* --------------------------- Community ------------------------------- */

model Review {
  id         String        @id @default(cuid())
  productId  String
  userId     String?
  author     String
  rating     Int           @db.SmallInt
  title      String
  body       String
  verified   Boolean       @default(false)
  approved   Boolean       @default(true)
  helpful    Int           @default(0)
  createdAt  DateTime      @default(now())
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  images     ReviewImage[]
  videos     ReviewVideo[]

  @@index([productId, approved, createdAt])
  @@index([userId])
}

model ReviewImage {
  id       String @id @default(cuid())
  reviewId String
  url      String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model ReviewVideo {
  id       String @id @default(cuid())
  reviewId String
  url      String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

/* --------------------- Commerce mirrors (Medusa) --------------------- */

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Cart {
  id           String     @id @default(cuid())
  medusaCartId String     @unique
  email        String?
  userId       String?
  couponCode   String?
  abandonedAt  DateTime?
  createdAt    DateTime   @default(now())
  items        CartItem[]

  @@index([email, abandonedAt])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  title     String
  unitPrice Int
  quantity  Int
  cart      Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
}

model Order {
  id             String        @id @default(cuid())
  medusaOrderId  String        @unique
  displayId      Int
  email          String
  userId         String?
  status         OrderStatus   @default(PENDING)
  subtotal       Int
  discount       Int           @default(0)
  shipping       Int           @default(0)
  codFee         Int           @default(0)
  gstIncluded    Int           @default(0)
  total          Int
  couponCode     String?
  paymentMethod  String
  placedAt       DateTime      @default(now())
  items          OrderItem[]
  payments       Payment[]
  invoiceNumber  String?       @unique

  @@index([email, placedAt])
  @@index([status])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  variantId String
  title     String
  unitPrice Int
  quantity  Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  gateway      String // razorpay | cashfree | cod
  gatewayRef   String        @unique // payment_id / cf order id / COD ref
  amount       Int
  status       PaymentStatus @default(CREATED)
  method       String?
  createdAt    DateTime      @default(now())
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([orderId])
}

model Transaction {
  id        String   @id @default(cuid())
  paymentId String
  type      String // capture | refund | webhook
  amount    Int
  raw       Json
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

/* --------------------------- Promotions ------------------------------ */

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  label       String
  percentOff  Int
  maxDiscount Int?
  minSubtotal Int       @default(0)
  usageLimit  Int?
  usedCount   Int       @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)

  @@index([isActive, expiresAt])
}

model GiftCard {
  id        String    @id @default(cuid())
  code      String    @unique
  balance   Int
  initial   Int
  issuedTo  String?
  expiresAt DateTime?
  isActive  Boolean   @default(true)
}

/* -------------------------- Subscriptions ---------------------------- */

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  variantId       String
  title           String
  unitPrice       Int
  discountPct     Int                @default(15)
  intervalDays    Int                @default(30)
  nextDeliveryAt  DateTime
  status          SubscriptionStatus @default(ACTIVE)
  createdAt       DateTime           @default(now())
  cancelledAt     DateTime?
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, nextDeliveryAt])
}

/* ------------------------ Inventory mirrors -------------------------- */

model Warehouse {
  id                    String          @id @default(cuid())
  medusaStockLocationId String?         @unique
  name                  String
  city                  String
  state                 String
  pincode               String
  movements             StockMovement[]
  inventory             Inventory[]
}

model Inventory {
  id                    String    @id @default(cuid())
  warehouseId           String
  medusaInventoryItemId String
  sku                   String
  quantity              Int       @default(0)
  updatedAt             DateTime  @updatedAt
  warehouse             Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, medusaInventoryItemId])
  @@index([sku])
}

enum MovementType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
  RETURN
}

model StockMovement {
  id          String       @id @default(cuid())
  warehouseId String
  sku         String
  type        MovementType
  quantity    Int
  reference   String? // order display id / GRN / adjustment note
  createdAt   DateTime     @default(now())
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId, createdAt])
  @@index([sku])
}

/* ------------------------- Comms & support --------------------------- */

model Notification {
  id        String    @id @default(cuid())
  userId    String
  channel   String // email | sms | push | inapp
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String    @default("footer")
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  handledAt DateTime?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String          @id @default(cuid())
  userId    String?
  email     String
  subject   String
  status    TicketStatus    @default(OPEN)
  priority  Int             @default(2) @db.SmallInt // 1 high · 2 normal · 3 low
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages  TicketMessage[]

  @@index([status, priority, updatedAt])
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  fromStaff Boolean       @default(false)
  body      String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/* ------------------------------ Audit -------------------------------- */

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String // order.placed, review.created…
  meta      Json
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String // refund.initiated, review.moderated…
  targetType String
  targetId   String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetType, targetId])
}
