# ─── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SKIP_ENV_VALIDATION=

# ─── Medusa (Commerce Backend) ───────────────────────────────────────
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_
MEDUSA_REVALIDATE_SECRET=

# ─── Sanity (CMS) ────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=

# ─── Auth.js ─────────────────────────────────────────────────────────
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Analytics ───────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─── Monitoring (Sentry) ─────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Email (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM="Cefalu <hello@cefalu.in>"

# ─── SMS (MSG91) ─────────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=CEFALU
MSG91_OTP_TEMPLATE_ID=

# ─── Payments ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ─── Storage (Amazon S3) ─────────────────────────────────────────────
S3_REGION=ap-south-1
S3_BUCKET=cefalu-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ─── Medusa backend only ─────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cefalu
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# ---------- Day 3: platform, payments, roles, storage ----------
# Prisma platform database (content/community/audit — Medusa keeps commerce)
PLATFORM_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cefalu_platform"

# Razorpay webhooks (Dashboard → Webhooks → secret)
RAZORPAY_WEBHOOK_SECRET=""

# Cashfree Payment Gateway (sandbox|production)
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="sandbox"

# Medusa Admin API (secret key sk_… from Settings → API Keys) — powers /api/admin/*
MEDUSA_ADMIN_API_KEY=""

# Role assignment (comma-separated emails)
ADMIN_EMAILS="founder@cefalu.in"
MODERATOR_EMAILS=""

# Google OAuth (enables the Google button automatically when both are set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Amazon S3 uploads (presigned PUT via /api/admin/uploads)
S3_REGION="ap-south-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FILE_URL=""            # optional CDN/CloudFront base for public URLs
# S3_ENDPOINT=""          # optional (MinIO/R2)

# MSG91 DLT flow template IDs (service layer in lib/sms.ts)
MSG91_TPL_OTP=""
MSG91_TPL_ORDER_PLACED=""
MSG91_TPL_ORDER_SHIPPED=""
MSG91_TPL_ORDER_DELIVERED=""

# Structured log level: debug|info|warn|error
LOG_LEVEL="info"
