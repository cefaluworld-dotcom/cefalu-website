{
  "name": "cefalu-in",
  "version": "1.0.0",
  "private": true,
  "description": "Cefalu apparel ecommerce storefront",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "medusa:dev": "pnpm --dir medusa dev",
    "medusa:build": "pnpm --dir medusa build",
    "medusa:seed": "pnpm --dir medusa seed",
    "clean": "rm -rf .next node_modules/.cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-env": "node scripts/check-env.mjs",
    "start:prod": "node scripts/check-env.mjs && next start",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@hookform/resolvers": "^5.9.1",
    "@medusajs/js-sdk": "^2.8.4",
    "@medusajs/types": "^2.8.4",
    "@next/third-parties": "^16.3.6",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@react-email/components": "^1.0.12",
    "@sanity/image-url": "^2.1.1",
    "@sentry/nextjs": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.3",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-auth": "5.0.0-beta.32",
    "next-sanity": "^13.3.4",
    "next-themes": "^0.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.2",
    "resend": "^6.29.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.3",
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "3.1140.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "@playwright/test": "^1.49.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@axe-core/playwright": "^4.10.1",
    "tsx": "^4.19.2"
  }
}
